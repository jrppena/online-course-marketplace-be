generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id // Firebase uid
  email     String   @unique
  firstName String
  lastName  String
  role      Role     @default(USER)
  bio       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
