{
  "name": "online-course-marketplace-be",
  "version": "1.0.0",
  "description": "default template",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc && tsc-alias",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest src/test/unit --run",
    "test:e2e": "vitest src/test/e2e --run",
    "test:ci": "vitest run --coverage",
    "test:ci:unit": "vitest run src/test/unit --coverage",
    "test:ci:e2e": "vitest run src/test/e2e --coverage",
    "docker:dev": "docker-compose -f docker-compose.yml up --build",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up --build",
    "docker:prod": "docker build -f Dockerfile.prod -t ${npm_package_name}:latest ."
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "morgan": "^1.10.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^3.1.0",
    "prisma": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@swc/core": "^1.9.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.3"
  }
}
