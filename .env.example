# ===========================================
# online-course-marketplace-be Environment Variables
# Copy this file to .env and fill in real values
# ===========================================

# Application Settings
PORT=8080                              # online-course-marketplace-fe dev server owns port 3000

# Neon Postgres (https://neon.tech)
# Pooled connection string (used by the running app)
DATABASE_URL=
# Direct/unpooled connection string (used by Prisma CLI + migrations)
DIRECT_URL=

# Firebase Admin SDK
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Logging Configuration
LOG_DIR=logs                           # 로그 파일 저장 디렉토리
LOG_LEVEL=info                         # 로그 레벨 (debug/info/warn/error)

# CORS Configuration (must match online-course-marketplace-fe's dev server)
ORIGIN=http://localhost:3000
CREDENTIALS=true
CORS_ORIGINS=http://localhost:3000

# External Services
API_SERVER_URL=https://api.yourdomain.com  # API 서버 기본 URL

# Optional Services
SENTRY_DSN=                            # Sentry 에러 트래킹 DSN (선택적)
REDIS_URL=redis://localhost:6379       # Redis 캐시 서버 URL (선택적)

# Additional Environment-specific Settings
# 추가 환경별 설정은 .env.{NODE_ENV}.local 파일을 사용하세요
# Example: .env.development.local, .env.production.local, .env.test.local
